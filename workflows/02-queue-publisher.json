        "jsCode": "// Fix #2: اگر مسیر «Platform ناشناخته» از قبل یک delivery معتبر ساخته، آن را عیناً حفظ کن و دوباره\n// از صفر بر اساس resp.statusCode/resp.body تحلیل نکن (باگ قبلی: Unknown Platform به اشتباه sent می‌شد).\nconst original = $('آماده‌سازی Context انتشار').first().json;\nconst resp = $input.first().json;\n\n// Fix #5: Redact بازگشتی هر فیلد حساس (authorization/token/secret/cookie) قبل از این‌که پاسخ برای ذخیره در\n// Data Table آماده شود. مقادیر اصلی (raw) فقط همین‌جا و به‌صورت موقت برای محاسبه ok/permanent استفاده می‌شوند و\n// خودشان هرگز ذخیره نمی‌شوند؛ فقط نسخه Redact‌شده در delivery.response قرار می‌گیرد.\nconst SENSITIVE_KEY_RE = /(authorization|token|secret|cookie)/i;\nfunction redact(value, depth) {\n  if (depth > 8) return '[REDACTED:max-depth]';\n  if (Array.isArray(value)) return value.map(v => redact(v, depth + 1));\n  if (value && typeof value === 'object') {\n    const out = {};\n    for (const [k, v] of Object.entries(value)) {\n      out[k] = SENSITIVE_KEY_RE.test(k) ? '[REDACTED]' : redact(v, depth + 1);\n    }\n    return out;\n  }\n  return value;\n}\n\nfunction buildDelivery() {\n  if (resp.delivery && typeof resp.delivery === 'object') {\n    // مسیر Fallback (Platform ناشناخته) — delivery از قبل ساخته شده، فقط پاسخ آن را Redact می‌کنیم.\n    return {\n      ...resp.delivery,\n      response: redact(resp.delivery.response, 0),\n      finishedAt: resp.delivery.finishedAt || new Date().toISOString()\n    };\n  }\n\n  const statusCode = Number(resp.statusCode ?? (resp.body && resp.body.statusCode) ?? 200);\n  const body = resp.body !== undefined ? resp.body : resp;\n\n  // Fix #14: temporaryCodes اکنون واقعاً در طبقه‌بندی استفاده می‌شود تا مقصود کد صریح باشد\n  // (Permanent → دیگر Retry نکن. Temporary → طبق لیست شناخته‌شده Retry کن. Unknown → پیش‌فرض ایمن: Retry،\n  // چون شکست دائمی نادرست خطرناک‌تر از یک Retry اضافه است).\n  const permanentCodes = new Set([400,401,403,404,409,422]);\n  const temporaryCodes = new Set([408,425,429,500,502,503,504]);\n\n  const bodyOk = !(body && (body.ok === false || body.error || body.errors));\n  const ok = statusCode>=200 && statusCode<300 && bodyOk;\n\n  let classification = 'unknown';\n  if (!ok) {\n    if (permanentCodes.has(statusCode)) classification = 'permanent';\n    else if (temporaryCodes.has(statusCode)) classification = 'temporary';\n    else classification = 'unknown';\n  }\n  const permanent = classification === 'permanent';\n\n  return {ok, statusCode, permanent, classification, response: redact(body, 0), finishedAt: new Date().toISOString()};\n}\n\nconst delivery = buildDelivery();\nreturn [{json:{...original, delivery}}];"
      },
