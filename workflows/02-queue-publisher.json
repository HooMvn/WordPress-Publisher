      "notesInFlow": true,
      "notes": "Update by job_id: status=sent, sent_at=delivery.finishedAt, provider_status_code=delivery.statusCode, provider_response_json=JSON.stringify(delivery.response)"
    },
    {
      "parameters": {
        "jsCode": "const j=$input.first().json;\nconst attempts = Number(j.attempts||1);\nconst max = Number(j.max_attempts||5);\nconst permanent = Boolean(j.delivery.permanent);\nconst finalFailed = permanent || attempts>=max;\nconst delayMinutes = Math.min(60, Math.pow(2,attempts));\nconst errMsg = `HTTP ${j.delivery.statusCode} — ${JSON.stringify(j.delivery.response).slice(0,500)}`;\nreturn [{json:{...j, finalFailed, permanent, next_attempt_at: new Date(Date.now()+delayMinutes*60000).toISOString(), last_error: errMsg, status: finalFailed?'failed':'pending'}}];"
      },
      "id": "p-retry-calc",
      "name": "طبقه‌بندی خطا و محاسبه Retry/Backoff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        180
      ],
      "notesInFlow": true,
      "notes": "خطاهای دائمی (401/403/404/409/422) بلافاصله Failed می‌شوند. خطاهای موقتی (408/425/429/5xx) طبق Exponential Backoff (حداکثر ۶۰ دقیقه) دوباره تلاش می‌شوند تا سقف max_attempts."
    },
    {
      "parameters": {
