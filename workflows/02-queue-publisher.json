        "jsCode": "const j=$input.first().json; const a=j.article;\n// X (Twitter) POST /2/tweets: حداکثر 280 کاراکتر برای text.\nconst url=a.url;\nconst reserve=url.length+1;\nlet title=a.title;\nconst maxTitle=280-reserve;\nif(title.length>maxTitle) title=title.slice(0,Math.max(0,maxTitle-1))+'…';\nconst text=`${title}\\n${url}`;\nreturn [{json:{...j, formatted:{text}}}];"
