    {
      "parameters": {
        "jsCode": "const original = $('آماده‌سازی Context انتشار').first().json;\nconst resp = $input.first().json;\n// با fullResponse:true پاسخ HTTP Request شامل statusCode, headers, body است.\nconst statusCode = resp.statusCode || (resp.body && resp.body.statusCode) || 200;\nconst body = resp.body !== undefined ? resp.body : resp;\n\nconst permanentCodes = new Set([400,401,403,404,409,422]);\nconst temporaryCodes = new Set([408,425,429,500,502,503,504]);\n\nconst bodyOk = !(body && (body.ok === false || body.error || body.errors));\nconst ok = statusCode>=200 && statusCode<300 && bodyOk;\nconst permanent = !ok && permanentCodes.has(statusCode);\n\nreturn [{json:{...original, delivery:{ok, statusCode, permanent, response: body, finishedAt: new Date().toISOString()}}}];"
      },
