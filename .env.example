# نمونه تنظیمات WordPress → Multi-Platform Publisher
# مقادیر واقعی را هرگز Commit نکنید. این فایل فقط شکل و نام متغیرها را نشان می‌دهد.

# ---------------------------------------------------------------------------
# n8n / Infrastructure
# ---------------------------------------------------------------------------
N8N_HOST=n8n.example.com
N8N_ENCRYPTION_KEY=CHANGE_ME_WITH_OPENSSL_RANDOM_VALUE
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# WordPress
# ---------------------------------------------------------------------------
WORDPRESS_BASE_URL=https://your-wordpress-site.com
# Token فقط داخل n8n Credential «WordPress API Token» (Header Auth: Authorization = Bearer <token>) وارد شود.
# این خط صرفاً یادآوری است، مقدار واقعی اینجا قرار نگیرد.
WORDPRESS_API_TOKEN=CHANGE_ME_STORE_IN_N8N_CREDENTIAL_ONLY

# Fix #6/#7 (CODE_REVIEW.md): تنها Header رسمی احراز هویت Webhook اکنون X-WP-Webhook-Secret است.
# Header قدیمی X-Omid90-Webhook-Secret (باقی‌مانده پروژه قبلی) کاملاً حذف شد — دیگر پذیرفته نمی‌شود.
# مقایسه این Secret هم اکنون با crypto.timingSafeEqual انجام می‌شود، نه === ساده.
WORDPRESS_WEBHOOK_SECRET=CHANGE_ME_MIN_32_RANDOM_CHARS

# ---------------------------------------------------------------------------
# Dashboard API (Fix #4 — قبلاً این Endpoint کاملاً بدون Authentication بود)
# ---------------------------------------------------------------------------
# Header الزامی روی GET /webhook/wp-publication-dashboard: X-Dashboard-Api-Secret
# مستقل از WORDPRESS_WEBHOOK_SECRET نگه داشته شده چون مصرف‌کننده این دو مسیر متفاوت است
# (WordPress در برابر مدیر/مانیتورینگ)؛ لو رفتن یکی نباید مسیر دیگر را هم لو بدهد.
DASHBOARD_API_SECRET=CHANGE_ME_MIN_32_RANDOM_CHARS_DIFFERENT_FROM_WEBHOOK_SECRET

# ---------------------------------------------------------------------------
# n8n Variables عمومی
# ---------------------------------------------------------------------------
# لیست پلتفرم‌های فعال، جداشده با کاما — بدون تغییر Core قابل کم/زیاد شدن است.
ACTIVE_PLATFORMS=telegram,bale,eitaa,rubika,x,linkedin

ADMIN_ALERT_ENDPOINT=
ADMIN_ALERT_CHAT_ID=

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Fix #9: دیگر نیازی به TELEGRAM_API_BASE در Expression دستی نیست — Node رسمی
# n8n-nodes-base.telegram خودش Base URL رسمی api.telegram.org را مدیریت می‌کند.
TELEGRAM_CHAT_ID=
TELEGRAM_RATE_LIMIT_SECONDS=1
# Token فقط در Credential رسمی n8n Telegram (predefinedCredentialType: telegramApi) ذخیره شود.
# هرگز در URL/Expression/Log قرار نگیرد (طبق Fix #9، دیگر با $credentials.* در URL خوانده نمی‌شود).

# ---------------------------------------------------------------------------
# Bale
# ---------------------------------------------------------------------------
BALE_API_BASE=
BALE_CHAT_ID=
BALE_RATE_LIMIT_SECONDS=2
# Auth Header در Credential «WP Bale Header Auth» ذخیره شود.

# ---------------------------------------------------------------------------
# Eitaa (Gateway اختصاصی — مطابق مستندات واقعی Gateway خودتان تنظیم شود)
# ---------------------------------------------------------------------------
EITAA_TEXT_ENDPOINT=
EITAA_CHANNEL_ID=
EITAA_RATE_LIMIT_SECONDS=3
# Auth Header در Credential «WP Eitaa Header Auth» ذخیره شود.

# ---------------------------------------------------------------------------
# Rubika (Gateway اختصاصی — مطابق مستندات واقعی Gateway خودتان تنظیم شود)
# ---------------------------------------------------------------------------
RUBIKA_TEXT_ENDPOINT=
RUBIKA_CHANNEL_ID=
RUBIKA_RATE_LIMIT_SECONDS=3
# Auth Header در Credential «WP Rubika Header Auth» ذخیره شود.

# ---------------------------------------------------------------------------
# X (Twitter) — X API v2, POST /2/tweets
# نیازمند OAuth 2.0 با PKCE (user-context) و scope=tweet.write
# مستندات: https://docs.x.com
# ---------------------------------------------------------------------------
# Fix #13 (CODE_REVIEW.md): این متغیر قبلاً تعریف شده بود ولی Node واقعاً از آن استفاده نمی‌کرد
# (URL Hardcode بود). اکنون X Publisher واقعاً از $vars.X_API_BASE می‌خواند (با Fallback به
# https://api.x.com اگر خالی باشد) — تغییر این مقدار واقعاً URL نهایی درخواست را عوض می‌کند
# (مفید برای Sandbox/Mock API در تست).
X_API_BASE=https://api.x.com
X_RATE_LIMIT_SECONDS=2
# Access Token فقط در Credential httpBearerAuth با نام «WP X OAuth2» ذخیره شود.
X_USER_ID=

# ---------------------------------------------------------------------------
# LinkedIn — Posts API (/rest/posts) — نسخه UGC Posts قدیمی استفاده نشده است.
# مستندات: https://learn.microsoft.com/en-us/linkedin/marketing/community-management/shares/posts-api
# ---------------------------------------------------------------------------
LINKEDIN_API_VERSION=202504
LINKEDIN_AUTHOR_URN=urn:li:organization:CHANGE_ME
LINKEDIN_RATE_LIMIT_SECONDS=2
# Access Token فقط در Credential httpBearerAuth با نام «WP LinkedIn OAuth2» ذخیره شود.
# Scope لازم: w_member_social (پروفایل شخصی) یا w_organization_social (صفحه شرکت).
